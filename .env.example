# --- Telegram ---
# Токен бота от @BotFather (/newbot).
# Это единственный обязательный Telegram-параметр — chat_id больше не нужен,
# бот принимает любого пользователя, который ему напишет.
TELEGRAM_BOT_TOKEN=

# (опционально) Твой собственный Telegram user id — это даст тебе админ-команды
# (/admin_users, /admin_stats). Если оставить пустым, админ-команды будут отключены.
# Узнать id у @userinfobot.
ADMIN_TG_USER_ID=

# --- Шифрование ---
# Ключ для шифрования golden_key пользователей в БД. ОБЯЗАТЕЛЬНО.
# Сгенерировать новый:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ВАЖНО: если потерять этот ключ, все сохранённые golden_key станут нерасшифровываемыми
# и пользователям придётся заново отправлять /setkey.
ENCRYPTION_KEY=

# --- FunPay ---
# Задержка между опросами FunPay в секундах. Минимум 4, рекомендуется 6.
# Это значение применяется ко всем подключённым пользователям.
FUNPAY_POLL_DELAY=6

# --- Прочее ---
# Путь к SQLite-БД (хранит зашифрованные ключи, статистику, состояние).
DB_PATH=data/funpay_tg.db

# Уровень логирования: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

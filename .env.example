# --- FunPay ---
# Достань значение cookie golden_key из браузера, где ты залогинен в FunPay:
#   DevTools (F12) -> Application -> Cookies -> https://funpay.com -> golden_key
FUNPAY_GOLDEN_KEY=

# Опционально (но рекомендуется): User-Agent того же браузера, из которого взят golden_key.
# Открой DevTools -> Network -> любой запрос на funpay.com -> Request Headers -> user-agent.
# Если оставить пустым, FunPayAPI подставит свой дефолтный.
FUNPAY_USER_AGENT=

# Задержка между опросами FunPay в секундах. Минимум 4, рекомендуется 6.
FUNPAY_POLL_DELAY=6

# --- Telegram ---
# Токен бота от @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=

# Твой Telegram user id (узнай у @userinfobot). Только этот id сможет управлять ботом
# и получать уведомления.
TELEGRAM_CHAT_ID=

# --- Прочее ---
# Путь к SQLite-БД (хранит статистику, список заблокированных, состояние автоответчика).
DB_PATH=data/funpay_tg.db

# Уровень логирования: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
